# Copy this file to `.env.local.development`, `.env.local.staging`, and
# `.env.local.production` (all gitignored) and fill in real values before
# building/running the app. These files provide default POC login
# credentials used by SessionBootstrapper for auto-login at startup, one
# set of credentials per flavor.
DEFAULT_EMAIL=changeme@example.com
DEFAULT_PASSWORD=changeme
